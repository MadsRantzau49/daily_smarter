{
  "name": "daily-smarter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "admin:promote": "tsx scripts/promote-user.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.12.0",
    "@prisma/client": "^6.12.0",
    "argon2": "0.45.1",
    "date-fns": "4.1.0",
    "dotenv": "^17.2.2",
    "lucide-react": "0.544.0",
    "next": "16.3.8",
    "pg": "^8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "web-push": "3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.8.0",
    "@types/node": "24.5.2",
    "@types/pg": "^8.15.5",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@types/web-push": "3.6.4",
    "eslint": "9.36.0",
    "eslint-config-next": "16.3.8",
    "prettier": "3.6.2",
    "prisma": "^6.12.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "@prisma/client@6.12.0": true,
    "@prisma/engines@6.12.0": true,
    "argon2@0.45.1": true,
    "prisma@6.12.0": true,
    "esbuild@0.25.12": true,
    "unrs-resolver@1.12.2": true
  }
}
